<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The theme of the app once it is running. DARK parent and a dark window background: between the splash and the
        first Compose frame the window itself shows for an instant, and a light theme would flash white (D26).
    -->
    <style name="Theme.SwiftyProteins" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/swifty_abyss</item>
    </style>

    <!--
        The theme of the LAUNCH SCREEN (splash). The system applies it while the app starts; when the activity is ready,
        installSplashScreen() (MainActivity) swaps it for postSplashScreenTheme. It works on every API from 24.
        Android 12+ ALWAYS shows a system splash (it cannot be switched off). Ours is made invisible: abyss colour and an
        EMPTY icon, for as long as Android needs, so it blends into BootScreen, the launch screen that lasts over one
        second (document 08d).
    -->
    <style name="Theme.SwiftyProteins.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/swifty_abyss</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.SwiftyProteins</item>
    </style>
</resources>

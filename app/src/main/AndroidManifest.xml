<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The biometric dialog (document 05). A "normal" permission: granted at install, no question to the user.
         androidx.biometric declares it too; written here so the manifest says what the app does. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Saving to the gallery on Android 7-9 ONLY (document 18). From Android 10 an app adds its own pictures through
         MediaStore with no permission; maxSdkVersion keeps newer phones from even listing it. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SwiftyProteins">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SwiftyProteins.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets the chosen app read the shared image (document 09). The image lives in the app's PRIVATE cache;
            FileProvider turns it into a content:// address, and the share intent grants read access to that one file
            only. exported="false" + grantUriPermissions="true" is the required combination.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>